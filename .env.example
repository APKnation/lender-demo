# ---------------------------------------------------------------------------
# Lender Subsystem Configuration
# ---------------------------------------------------------------------------

# Django core
SECRET_KEY=replace-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Institution identity – configure per financial institution
LENDER_ID=NMB-001
INSTITUTION_NAME=NMB Bank
INSTITUTION_TYPE=COMMERCIAL_BANK
# CRDB, NMB, M-PESA, MIXX_BY_YAS, MICROFINANCE, COMMERCIAL_BANK, SACCOS, …

# Canonical borrower-reference prefix – derived from institution + country code
BORROWER_REF_PREFIX=BRW-TZ

# DAIRE Central System
CENTRAL_SYSTEM_URL=http://localhost:8000
CENTRAL_API_KEY=replace-me

# Database (PostgreSQL only – never SQLite)
DATABASE_URL=postgresql://lender_user:lender_password@localhost:5432/lender_db
POSTGRES_DB=lender_db
POSTGRES_USER=lender_user
POSTGRES_PASSWORD=lender_password

# Cache (Redis – optional, falls back to local memory)
REDIS_URL=redis://localhost:6379/1

# CORS / HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False

# Rate limiting (drf-standard-ratelimit values are passed via settings)
RATELIMIT_VIEW=100/m

# Initial super-user for Django Admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@lender.local
DJANGO_SUPERUSER_PASSWORD=change-me-admin
