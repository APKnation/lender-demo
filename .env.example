# ---------------------------------------------------------------------------
# Lender Subsystem Environment Configuration
# ---------------------------------------------------------------------------

# Django core
SECRET_KEY=replace-me-use-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Institution identity – change these per financial institution
LENDER_ID=NMB-001
INSTITUTION_NAME=NMB Bank
INSTITUTION_TYPE=COMMERCIAL_BANK
BORROWER_REF_PREFIX=BRW-TZ

# To switch to CRDB: set LENDER_ID=CRDB-001, INSTITUTION_NAME=CRDB Bank, etc.
# To switch to M-Pesa: set LENDER_ID=MPESA-001, INSTITUTION_TYPE=MOBILE_MONEY
# To switch to microfinance: set INSTITUTION_TYPE=MICROFINANCE

# DAIRE Central System (the caller that will authenticate with CENTRAL_API_KEY)
CENTRAL_SYSTEM_URL=http://localhost:8000
CENTRAL_API_KEY=replace-me

# Database (PostgreSQL only – NEVER SQLite)
DATABASE_URL=postgresql://lender_user:lender_password@localhost:5432/lender_db
POSTGRES_DB=lender_db
POSTGRES_USER=lender_user
POSTGRES_PASSWORD=lender_password

# Redis (optional – for caching/throttling)
REDIS_URL=redis://localhost:6379/1

# CORS / HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False

# Super-user for Django Admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@lender.local
DJANGO_SUPERUSER_PASSWORD=change-me-admin
